// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ------------------------------------------------------
// SYSTEM CONFIGURATION
// ------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ELECTION_OFFICER
}

model Admin {
  id        Int       @id @default(autoincrement()) @map("id")
  email     String    @unique
  password  String
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  role      AdminRole @default(ELECTION_OFFICER)
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("admins")
}

model AcademicYear {
  academicYearId Int    @id @default(autoincrement()) @map("academic_year_id")
  name           String @unique // e.g., "2025-2026"

  // Relations
  elections Election[]

  @@map("academic_years")
}

model Election {
  id             Int      @id @default(autoincrement()) @map("id")
  name           String
  academicYearId Int      @map("academic_year_id")
  isActive       Boolean  @default(false) @map("is_active")
  startTime      DateTime @default(now()) @map("start_time")
  endTime        DateTime @default(now()) @map("end_time")

  // Relations
  academicYear AcademicYear @relation(fields: [academicYearId], references: [academicYearId])
  candidates   Candidate[]
  votes        Vote[]

  @@unique([academicYearId, name])
  @@map("elections")
}

model Department {
  id       Int       @id @default(autoincrement())
  name     String
  acronym  String
  students Student[]

  @@map("departments")
}

model YearLevel {
  id       Int       @id @default(autoincrement())
  year     String
  students Student[]

  @@map("year_level")
}

model Position {
  positionId Int     @id @default(autoincrement()) @map("position_id")
  title      String // e.g., "President", "Senator", "Representative"
  maxVotes   Int     @map("max_votes") // e.g., 1 for Pres, 8 for Senator
  isGlobal   Boolean @map("is_global") // True for Pres/VP/Sen, False for Reps

  // Relations
  candidates Candidate[]
  votes      Vote[]

  @@map("positions")
}

// ------------------------------------------------------
// VOTER & CANDIDATE DATA
// ------------------------------------------------------

model Student {
  id         Int     @id @default(autoincrement()) @map("id")
  firstName  String  @map("first_name")
  middleName String? @map("middle_name")
  lastName   String  @map("last_name")
  email      String  @unique
  password   String
  isActive   Boolean @default(false) @map("is_active")

  departmentId Int @map("department_id")
  yearLevelId  Int @map("year_level_id")

  // Relations
  department  Department  @relation(fields: [departmentId], references: [id])
  yearLevel   YearLevel   @relation(fields: [yearLevelId], references: [id])
  candidacies Candidate[]
  votesCast   Vote[]

  @@map("students")
}

model Candidate {
  candidateId Int     @id @default(autoincrement()) @map("candidate_id")
  name        String? // for polling election
  studentId   Int?    @map("student_id") // for candidate election
  positionId  Int     @map("position_id")
  electionId  Int     @map("election_id")
  partyList   String? @map("party_list")
  imageUrl    String? @map("image_url") // for candidate election

  // Relations
  student  Student? @relation(fields: [studentId], references: [id])
  position Position @relation(fields: [positionId], references: [positionId])
  election Election @relation(fields: [electionId], references: [id])
  votes    Vote[]

  // Constraint: A student can only run once per election
  @@unique([studentId, electionId])
  @@map("candidates")
}

// ------------------------------------------------------
// TRANSACTIONS
// ------------------------------------------------------

model Vote {
  voteId            Int      @id @default(autoincrement()) @map("vote_id")
  studentId         Int      @map("student_id")
  candidateId       Int      @map("candidate_id")
  positionId        Int      @map("position_id")
  electionId        Int      @map("election_id")
  voterDepartmentId Int      @map("voter_department_id")
  voterYearLevelId  Int      @map("voter_year_level_id")
  timestamp         DateTime @default(now())

  // Relations
  student   Student   @relation(fields: [studentId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [candidateId])
  position  Position  @relation(fields: [positionId], references: [positionId])
  election  Election  @relation(fields: [electionId], references: [id])

  // Constraint: A student can only vote for a specific candidate once per election
  @@unique([studentId, candidateId, electionId])
  @@map("votes")
}

// ------------------------------------------------------
// OTP VERIFICATION
// ------------------------------------------------------

enum OtpType {
  SIGNUP
  LOGIN
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  email     String
  type      OtpType  @default(SIGNUP)
  otp       String
  data      String?  @db.Text
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, type])
  @@map("otp_verifications")
}
